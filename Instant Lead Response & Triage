        "jsCode": "const lead = $('Normalize Lead').first().json;\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && (r.Email || r.email));\n\nconst matches = lead.email\n  ? rows.filter(r => String(r.Email || r.email || '').toLowerCase().trim() === lead.email)\n  : [];\n\nconst last = matches.length ? matches[matches.length - 1] : null;\n\nreturn [{\n  json: {\n    ...lead,\n    isDuplicate: matches.length > 0,\n    priorTouches: matches.length,\n    lastGrade: last ? (last.Grade || '') : '',\n    lastSeen: last ? (last['Received At'] || '') : ''\n  }\n}];"
