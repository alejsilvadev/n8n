    {
      "parameters": {
        "jsCode": "const lead = $('Flag Duplicate').first().json;\n\n// The node output shape varies by model/provider - handle all of them.\nlet ai = $json.message?.content ?? $json.content ?? $json.text ?? $json.output ?? $json;\n\nif (typeof ai === 'string') {\n  const cleaned = ai.replace(/```json/gi, '').replace(/```/g, '').trim();\n  try {\n    ai = JSON.parse(cleaned);\n  } catch (e) {\n    ai = { summary: cleaned.slice(0, 300) };\n  }\n}\nif (typeof ai !== 'object' || ai === null) ai = {};\n\n// If the AI call failed entirely, fall back to WARM so no lead is ever silently dropped.\nconst score = Math.max(0, Math.min(100, Number(ai.score ?? 55)));\nconst isSpam = ai.is_spam === true || ai.is_spam === 'true';\nconst urgency = String(ai.urgency || 'medium').toLowerCase();\n\nlet grade = 'warm';\nif (isSpam || score < 25) grade = 'spam';\nelse if (score >= 70 || urgency === 'high') grade = 'hot';\n\nconst questions = Array.isArray(ai.questions_to_ask) ? ai.questions_to_ask : [];\n\nreturn [{\n  json: {\n    ...lead,\n    score,\n    grade,\n    isSpam,\n    urgency,\n    intent: ai.intent || '',\n    serviceLine: ai.service_line || lead.service || 'General enquiry',\n    budgetSignal: ai.budget_signal || 'unknown',\n    summary: ai.summary || String(lead.message || '').slice(0, 200),\n    nextStep: ai.next_step || 'Call within one business day',\n    questions,\n    questionsText: questions.length ? questions.join('  |  ') : 'n/a',\n    replyBody: ai.suggested_reply || \"Thanks for getting in touch. I've got your details and I'm reviewing them now - I'll come back to you shortly with next steps. If it's urgent, just reply to this email and it comes straight to me.\",\n    status: 'New'\n  }\n}];"
      },
