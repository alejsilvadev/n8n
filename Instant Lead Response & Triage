      "parameters": {
        "jsCode": "// Different forms send different field names. Normalise everything into one schema.\nconst raw = $input.first().json;\nconst body = raw.body ?? raw;\n\nconst norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');\nconst entries = Object.entries(body || {});\n\nconst pick = (...keys) => {\n  for (const key of keys) {\n    const want = norm(key);\n    const hit = entries.find(([k, v]) =>\n      norm(k) === want && v !== undefined && v !== null && String(v).trim() !== ''\n    );\n    if (hit) return String(hit[1]).trim();\n  }\n  return '';\n};\n\nconst email = pick('email', 'emailAddress', 'userEmail', 'contactEmail', 'e-mail', 'your email').toLowerCase();\nconst phone = pick('phone', 'phoneNumber', 'mobile', 'tel', 'telephone', 'contact number');\n\nconst fullName =\n  pick('name', 'fullName', 'yourName', 'contactName') ||\n  [pick('firstName', 'fname', 'first'), pick('lastName', 'lname', 'last')].filter(Boolean).join(' ');\n\nconst message = pick(\n  'message', 'comments', 'details', 'description', 'inquiry', 'enquiry',\n  'notes', 'howCanWeHelp', 'projectDetails', 'what do you need'\n);\n\nreturn [{\n  json: {\n    leadId: 'L-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n    receivedAt: new Date().toISOString(),\n    fullName: fullName || 'there',\n    firstName: (fullName || '').trim().split(/\\s+/)[0] || 'there',\n    email,\n    phone,\n    company: pick('company', 'companyName', 'business', 'organization', 'organisation'),\n    service: pick('service', 'serviceNeeded', 'interestedIn', 'productType', 'subject', 'topic'),\n    budget: pick('budget', 'estimatedBudget', 'priceRange', 'spend'),\n    timeline: pick('timeline', 'whenDoYouNeedThis', 'startDate', 'timeframe'),\n    message,\n    source: pick('source', 'utm_source', 'referrer', 'leadSource', 'how did you hear about us') || 'website-form',\n    // A lead with no way to contact them is worthless - flag it instead of throwing\n    hasContact: Boolean(email || phone)\n  }\n}];"
      },
